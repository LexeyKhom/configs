{
  "with": {
    "prefix": "with",
    "body": [
      "WITH ${1:name} AS (",
      "\tSELECT ${3:attribute} FROM ${2:tableName}",
      ")"
    ],
    "description": "With"
  },
  "withr": {
    "prefix": "withr",
    "body": [
      "WITH RECURSIVE ${1:name} AS (",
      "\tSELECT ${3:attribute} FROM ${2:tableName}",
      ")"
    ],
    "description": "With Recursive"
  },
  "values": {
    "prefix": "values",
    "body": ["VALUES (${1:values})"],
    "description": "Values"
  },
  "join": {
    "prefix": "join",
    "body": ["INNER JOIN ${1:tableName}", "ON ${2:match}"],
    "description": "Inner Join"
  },
  "joinright": {
    "prefix": "joinright",
    "body": ["RIGHT OUTER JOIN ${1:tableName}", "ON ${2:match}"],
    "description": "Right Join"
  },
  "joinleft": {
    "prefix": "joinleft",
    "body": ["LEFT OUTER JOIN ${1:tableName}", "ON ${2:match}"],
    "description": "Left Join"
  },
  "joinfull": {
    "prefix": "joinfull",
    "body": ["FULL OUTER JOIN ${1:tableName}", "ON ${2:match}"],
    "description": "Full Join"
  },
  "where": {
    "prefix": "where",
    "body": "WHERE ${1:condition}",
    "description": "Where"
  },
  "orderby": {
    "prefix": "orderby",
    "body": "ORDER BY ${1:attribute} ${2:ASC|DESC}",
    "description": "Order by"
  },
  "having": {
    "prefix": "having",
    "body": "HAVING ${1:condition}",
    "description": "Having"
  },
  "window": {
    "prefix": "window",
    "body": [
      "WINDOW ${1:windowName} AS (",
      "\tPARTITION BY ${2:partition}",
      "\tORDER BY ${3:attribute}",
      ");"
    ],
    "description": "Window"
  },
  "over window": {
    "prefix": "overwindow",
    "body": [
      "OVER (",
      "\tPARTITION BY ${1:partition}",
      "\tORDER BY ${2:attribute}",
      ")"
    ],
    "description": "Window"
  },
  "limit": {
    "prefix": "limit",
    "body": "LIMIT ${1:number}",
    "description": "Limit"
  },
  "offset": {
    "prefix": "offset",
    "body": "OFFSET ${1:number}",
    "description": "Offset"
  },
  "count": {
    "prefix": "count",
    "body": "COUNT(${1:*})",
    "description": "Function `count`"
  },
  "sum": {
    "prefix": "sum",
    "body": "SUM(${1:number_attribute})",
    "description": "Function `sum`"
  },
  "avg": {
    "prefix": "avg",
    "body": "AVG(${1:number_attribute})",
    "description": "Function `avg`"
  },
  "round": {
    "prefix": "round",
    "body": "ROUND(${1:number_attribute}, ${2:scale})",
    "description": "Function `round`"
  }
}
