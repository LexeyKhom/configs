{
  "createt": {
    "prefix": "createt",
    "body": ["CREATE TABLE ${1:tableName} (", "\t${2:attribute}", ");"],
    "description": "Create regular table"
  },
  "createti": {
    "prefix": "createti",
    "body": [
      "CREATE TABLE IF NOT EXISTS ${1:tableName} (",
      "\t${2:attribute}",
      ");"
    ],
    "description": "Create table with conditional"
  },
  "created": {
    "prefix": "created",
    "body": ["CREATE DATABASE ${1:name};"],
    "description": "Create regular table"
  },
  "createdi": {
    "prefix": "createdi",
    "body": ["CREATE DATABASE IF NOT EXISTS ${1:name};"],
    "description": "Create table with conditional"
  },
  "dropt": {
    "prefix": "dropt",
    "body": ["DROP TABLE ${1:tableName};"],
    "description": "Drop table"
  },
  "dropti": {
    "prefix": "dropti",
    "body": ["DROP TABLE IF EXISTS ${1:tableName};"],
    "description": "Drop table with conditional"
  },
  "dropd": {
    "prefix": "dropd",
    "body": ["DROP DATABASE ${1:dbName};"],
    "description": "Drop database"
  },
  "dropdi": {
    "prefix": "dropdi",
    "body": ["DROP DATABASE IF EXISTS ${1:dbName};"],
    "description": "Drop database with conditional"
  },
  "altert": {
    "prefix": "altert",
    "body": ["ALTER TABLE ${1:tableName}", "\t ${2:intructions};"],
    "description": "Alter table"
  },
  "alterad": {
    "prefix": "alterad",
    "body": ["ALTER TABLE ${1:tableName}", "\tADD COLUMN ${2:col_name};"],
    "description": "Alter table - Add column"
  },
  "alteraf": {
    "prefix": "alteraf",
    "body": [
      "ALTER TABLE ${1:tableName}",
      "\tADD COLUMN ${2:col_name}",
      "\tAFTER ${5:col_name};"
    ],
    "description": "Alter table - Add column after"
  },
  "alterdb": {
    "prefix": "alterdb",
    "body": [
      "ALTER DATABASE ${1:dbName}",
      "\tCHARACTER SET ${2:charset}",
      "\tCOLLATE ${3:utf8_unicode_ci};"
    ],
    "description": "Alter database"
  },
  "bakupd": {
    "prefix": "bakupd",
    "body": ["BACKUP DATABASE ${1:dbName}", "\tTO DISK ${2:filepath};"],
    "description": "Backup database"
  },
  "bakupdw": {
    "prefix": "bakupdw",
    "body": [
      "BACKUP DATABASE ${1:dbName}",
      "\tTO DISK ${2:filepath}",
      "\tWITH ${3:DIFERENTIAL};"
    ],
    "description": "Diferencial backup database"
  },
  "creteuser": {
    "prefix": "createuser",
    "body": "CREATE USER '${1:username}'@'${2:localhost}' IDENTIFIED BY '${3:password}';",
    "description": "Create User"
  },
  "deleteuser": {
    "prefix": "deleteuser",
    "body": "DELETE FROM mysql.user WHERE user = '${1:userName}';",
    "description": "Delete user"
  },
  "grantuser": {
    "prefix": "grantuser",
    "body": "GRANT ALL PRIVILEGES ON ${1:db}.${2:tb} TO '${3:user_name}'@'${4:localhost}';",
    "description": "Grant privileges"
  },
  "insert": {
    "prefix": "insert",
    "body": [
      "INSERT INTO ${1:tableName} (",
      "\t${2:attribute}",
      ") VALUES ( ${3:values} )"
    ],
    "description": "Insert value(s)"
  },
  "updatet": {
    "prefix": "updatet",
    "body": [
      "UPDATE ${1:tableName}",
      "\tSET ${2:attribute}",
      "\tWHERE ${3:condition};"
    ],
    "description": "Update table"
  },
  "delete": {
    "prefix": "delete",
    "body": ["DELETE FROM ${1:tableName}", "\tWHERE ${2:condition};"],
    "description": "Delete records"
  },
  "with": {
    "prefix": "with",
    "body": [
      "WITH ${1:name} AS (",
      "\tSELECT ${3:attribute} FROM ${2:tableName}",
      ")"
    ],
    "description": "With"
  },
  "withr": {
    "prefix": "withr",
    "body": [
      "WITH RECURSIVE ${1:name} AS (",
      "\tSELECT ${3:attribute} FROM ${2:tableName}",
      ")"
    ],
    "description": "With Recursive"
  },
  "select": {
    "prefix": "select",
    "body": ["SELECT ${2:attribute} FROM ${1:tableName}"],
    "description": "Regular select"
  },
  "selectd": {
    "prefix": "selectd",
    "body": ["SELECT DISTINCT ${2:attribute}", "\tFROM ${1:tableName}"],
    "description": "Select Distinct"
  },
  "values": {
    "prefix": "values",
    "body": ["VALUES (${1:values})"],
    "description": "Values"
  },
  "join": {
    "prefix": "join",
    "body": ["INNER JOIN ${1:tableName}", "ON ${2:match}"],
    "description": "Inner Join"
  },
  "joinright": {
    "prefix": "joinright",
    "body": ["RIGHT OUTER JOIN ${1:tableName}", "ON ${2:match}"],
    "description": "Right Join"
  },
  "joinleft": {
    "prefix": "joinleft",
    "body": ["LEFT OUTER JOIN ${1:tableName}", "ON ${2:match}"],
    "description": "Left Join"
  },
  "joinfull": {
    "prefix": "joinfull",
    "body": ["FULL OUTER JOIN ${1:tableName}", "ON ${2:match}"],
    "description": "Full Join"
  },
  "union": {
    "prefix": "union",
    "body": ["UNION"],
    "description": "Regular union"
  },
  "uniona": {
    "prefix": "unionall",
    "body": ["UNION ALL"],
    "description": "All union"
  },
  "groupby": {
    "prefix": "groupby",
    "body": ["GROUP BY ${1:attribute}"],
    "description": "Group by"
  },
  "primaryk": {
    "prefix": "primaryk",
    "body": ["PRIMARY KEY(${1:attribute})"],
    "description": "Primary Key"
  },
  "primarykc": {
    "prefix": "primarykc",
    "body": ["CONSTRAINT ${1:attribute} PRIMARY KEY(${2:attribute})"],
    "description": "Constraint rimary Key"
  },
  "foreingk": {
    "prefix": "foreingk",
    "body": [
      "FOREIGN KEY(${1:attribute}) REFERENCES ${2:tableName}(${3:attribute})"
    ],
    "description": "Foreing Key"
  },
  "foreingkc": {
    "prefix": "foreingkc",
    "body": [
      "CONSTRAINT ${1:attribute} FOREIGN KEY (${2:attribute})",
      "\tREFERENCES ${3:tableName}(${4:attribute})"
    ],
    "description": "Constraint foreing Key"
  },
  "check": {
    "prefix": "check",
    "body": ["CHECK ( ${1:condition} )"],
    "description": "Check"
  },
  "where": {
    "prefix": "where",
    "body": "WHERE ${1:condition}",
    "description": "Where"
  },
  "orderby": {
    "prefix": "orderby",
    "body": "ORDER BY ${1:attribute} ${2:ASC|DESC}",
    "description": "Order by"
  },
  "having": {
    "prefix": "having",
    "body": "HAVING ${1:condition}",
    "description": "Having"
  },
  "window": {
    "prefix": "window",
    "body": [
      "WINDOW ${1:windowName} AS (",
      "\tPARTITION BY ${2:partition}",
      "\tORDER BY ${3:attribute}",
      ");"
    ],
    "description": "Window"
  },
  "over window": {
    "prefix": "overwindow",
    "body": [
      "OVER (",
      "\tPARTITION BY ${1:partition}",
      "\tORDER BY ${2:attribute}",
      ")"
    ],
    "description": "Window"
  },
  "limit": {
    "prefix": "limit",
    "body": "LIMIT ${1:number}",
    "description": "Limit"
  },
  "offset": {
    "prefix": "offset",
    "body": "OFFSET ${1:number}",
    "description": "Offset"
  },
  "count": {
    "prefix": "count",
    "body": "COUNT(${1:*})",
    "description": "Function `count`"
  },
  "sum": {
    "prefix": "sum",
    "body": "SUM(${1:number_attribute})",
    "description": "Function `sum`"
  },
  "avg": {
    "prefix": "avg",
    "body": "AVG(${1:number_attribute})",
    "description": "Function `avg`"
  },
  "round": {
    "prefix": "round",
    "body": "ROUND(${1:number_attribute}, ${2:scale})",
    "description": "Function `round`"
  }
}
