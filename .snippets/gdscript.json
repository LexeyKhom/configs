{
  "Class name": {
    "prefix": "class_name",
    "body": ["class_name ${1:Name}"]
  },
  "Inner class": {
    "prefix": "class",
    "body": ["class $1 extends ${2:Reference}", "\t$3"]
  },
  "Print messages to console": {
    "prefix": "pr",
    "body": ["print($1)"]
  },
  "_ready method of Node": {
    "prefix": "ready",
    "body": ["func _ready() -> void:", "\t${1:pass}"]
  },
  "_init method of Object": {
    "prefix": "init",
    "body": ["func _init() -> void:", "\t${1:pass}"]
  },
  "_process method of Node": {
    "prefix": "process",
    "body": ["func _process(delta: float) -> void:", "\t${1:pass}"]
  },
  "_draw method of Node": {
    "prefix": "draw",
    "body": ["func _draw() -> void:", "\t${1:pass}"]
  },
  "_input method of Node": {
    "prefix": "input",
    "body": ["func _input(event: InputEvent) -> void:", "\t${1:pass}"]
  },
  "_input_event method of Node": {
    "prefix": "inpute",
    "body": ["func _input_event(event: InputEvent) -> void:", "\t${1:pass}"]
  },
  "_gui_input method of Node": {
    "prefix": "guii",
    "body": ["func _gui_input(event: InputEvent) -> void:", "\t${1:pass}"]
  },
  "for loop": {
    "prefix": "for",
    "body": ["for $1 in $2:", "\t${3:pass}"]
  },
  "for range loop": {
    "prefix": "inrange",
    "body": ["for $1 in range(${2:start}{$3:,end}):", "\t${4:pass}"]
  },
  "if elif else": {
    "prefix": "ifelif",
    "body": [
      "if ${1:condition}:",
      "\t${3:pass}",
      "elif ${2:condition}:",
      "\t${4:pass}",
      "else:",
      "\t${5:pass}"
    ]
  },
  "if else": {
    "prefix": "ifel",
    "body": ["if ${1:condition}:", "\t${2:pass}", "else:", "\t${3:pass}"]
  },
  "if": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "\t${2:pass}"]
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:condition}:", "\t${2:pass}"]
  },
  "function define": {
    "prefix": "func",
    "body": ["func ${1:method}($2) -> ${3:void}:", "\t${4:pass}"]
  },
  "match": {
    "prefix": "match",
    "body": ["match ${1:expression}: \n\t${2:pattern}:\n\t\t$0\n"]
  },
  "signal declaration": {
    "prefix": "signal",
    "body": ["signal ${1:signalname}(${2:args})"]
  },
  "export group": {
    "prefix": "@export_group",
    "body": ["@export_group('${1:name}')"]
  },
  "export variables": {
    "prefix": "@export",
    "body": ["@export var ${1:name} :$3=$2"]
  },
  "export range": {
    "prefix": "@export_range",
    "body": ["@export_range(${1:0.0}, ${2:1.0}) var ${3:name} :$5=$4"]
  },
  "define onready variables": {
    "prefix": "@onready",
    "body": ["@onready var ${1:name} :$3=$2"]
  },
  "define variables": {
    "prefix": "var",
    "body": ["var ${1:name} :$3=$2"]
  },
  "define constants": {
    "prefix": "const",
    "body": ["const ${1:name} :$3=$2"]
  },
  "Is instance of a class or script": {
    "prefix": "is",
    "body": ["${1:instance} is ${2:class}"]
  },
  "element in array": {
    "prefix": "in",
    "body": ["${1:element} in ${$2:array}"]
  },
  "pass statement": {
    "prefix": "pass",
    "body": ["pass"]
  }
}
